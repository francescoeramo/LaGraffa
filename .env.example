# Copia questo file in .env per lo sviluppo locale. Non committare mai .env.
GROQ_API_KEY=replace_with_your_groq_api_key
# Opzionale: usa DeepL API Free per le traduzioni brevi; senza chiave viene usato MyMemory.
DEEPL_API_KEY=replace_with_your_deepl_free_api_key

# Solo server, produzione: token GitHub limitato a LaGraffa, Actions read/write.
GITHUB_REFRESH_TOKEN=replace_with_your_github_token
